# LyricSense Backend Environment Configuration

# Whisper model size: tiny (~75MB), base (~145MB), small (~480MB), medium (~1.5GB), large-v3 (~3.1GB)
# 'small' is the recommended Mac/CPU default (fast inference with strong lyric accuracy).
# Note: 'large-v3' is the most accurate model, but is slow on CPU and should be used with CUDA or when processing speed does not matter.
MODEL_SIZE=small

# Device: 'cpu' or 'cuda' (falls back to cpu if CUDA is unavailable)
DEVICE=cpu

# Compute type: 'int8' (recommended for CPU), 'float16' (for GPU), or 'float32'
COMPUTE_TYPE=int8

# Voice Activity Detection (VAD) filter: 'true' or 'false'
# Default is false because default VAD can cut sustained singing notes
VAD_FILTER=false

# Default vocal separation mode: 'auto' (music vs speech energy heuristic), 'on' (force Demucs), or 'off'
SEPARATE_VOCALS_DEFAULT=auto

# Word confidence threshold: words with probability below this value are flagged as low_confidence
LOW_CONFIDENCE_THRESHOLD=0.4

# Alignment engine: 'whisperx' (phoneme/wav2vec forced alignment with native faster-whisper fallback)
ALIGNMENT_METHOD=whisperx

# Optional Groq Cloud API key for cloud transcription acceleration
# If unset, LyricSense runs locally via faster-whisper & WhisperX
GROQ_API_KEY=

# Optional custom directory to cache downloaded Whisper weights
# MODEL_CACHE_DIR=/path/to/cache

# Server host and port
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins for the frontend (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=500

# Optional custom temporary directory for uploaded audio processing
# TEMP_DIR=/tmp/lyricsense
