# LyricSense Backend Environment Configuration

# Whisper model size: tiny (~75MB), base (~145MB), small (~480MB), medium (~1.5GB), large-v3 (~3GB)
# Default 'tiny' is recommended for initial local CPU testing
MODEL_SIZE=tiny

# Device: 'cpu' or 'cuda' (falls back to cpu if CUDA is unavailable)
DEVICE=cpu

# Compute type: 'int8' (recommended for CPU), 'float16' (for GPU), or 'float32'
COMPUTE_TYPE=int8

# Optional custom directory to cache downloaded Whisper weights
# MODEL_CACHE_DIR=/path/to/cache

# Server host and port
HOST=0.0.0.0
PORT=8000

# Allowed CORS origins for the frontend (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=500

# Optional custom temporary directory for uploaded audio processing
# TEMP_DIR=/tmp/lyricsense
